      "fields": {
        "familySharable": false,
        "inAppPurchaseType": "NON_CONSUMABLE",
        "name": "Sats Keeper Plus",
        "reviewNote": "Sats Keeper is a read-only Bitcoin tracker. Adding a wallet needs only a\npublic Bitcoin address — no account, no sign-in, no private keys.\n\nThe free app tracks one wallet. Tapping + to add a second opens this\npurchase, which is a one-time unlock for unlimited wallets. There is no\nsubscription.\n\nTo reach it: tap + in the top right, paste any public Bitcoin address,\nname the wallet, and save. Tapping + a second time opens the purchase\nscreen.\n\nA public address you can paste for testing:\n1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa"
      },
